---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Sobre mí";

const identidad = {
  nombre: "Matías",
  pais: "México, cholula",
  ocupacion: "Estudiante",
  hobbies: ["leer", "videojuegos", "música"],
};

const habilidades = ["HTML", "CSS", "JavaScript", "Astro"];
const feliz = true;
const terminado = true;
const meta = 3;
const colorHabilidad = "crimson";
---
<BaseLayout pageTitle={pageTitle}>
  <style define:vars={{colorHabilidad}}>
    h1 {
      color: rgb(0, 48, 161);
      font-size: 4rem;
    }
    .skill {
      color: var(--colorHabilidad);
      font-weight: bold;
    }
  </style>
  <p>Aquí hay algunos datos sobre mí:</p>
  <ul>
    <li>Mi nombre es {identidad.nombre}.</li>
    <li>Vivo en {identidad.pais} y soy {identidad.ocupacion}.</li>
    {identidad.hobbies.length >= 2 &&
      <li>Dos de mis hobbies son: {identidad.hobbies[0]} y {identidad.hobbies[1]}</li>
    }
  </ul>

  <p>Mis habilidades son:</p>
  <ul>
    {habilidades.map((habilidad) => <li class="skill">{habilidad}</li>)}
  </ul>
  {feliz && <p>Estoy feliz de estar aprendiendo astro</p>}
  {terminado && <p>Ya termine este tutorial</p>}
  {meta === 3 ? <p>Mi meta es terminar hoy.</p> : <p>Mi meta no es en 2 días.</p>}
</BaseLayout>